# Copy to .env and fill in. Without an API key the app runs with stub summaries.
ENVIRONMENT=development
LOG_LEVEL=INFO

# OpenAI (same variable names as CHIA)
OPENAI_API_KEY=
SUMMARY_MODEL=gpt-5.4-mini

# Optional: route through Azure OpenAI instead (like CHIA's production setup)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2025-04-01-preview
AZURE_SUMMARY_DEPLOYMENT=

# Fetching
# 0 = only fetch when you click "Fetch new"
FETCH_INTERVAL_MINUTES=360
ITEMS_PER_QUERY=5
ALLOWED_ORIGINS=http://localhost:4200
