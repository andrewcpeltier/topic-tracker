# Copy to .env and fill in.
ENVIRONMENT=development
LOG_LEVEL=INFO

# Who writes the summaries:
#   claude_code = your Claude subscription, through the Claude Code CLI on this computer
#                 (install Claude Code and sign in once by running `claude`). No API key needed.
#   openai      = OPENAI_API_KEY below
#   stub        = placeholder text
#   auto        = OpenAI if a key is set, else Claude Code if installed, else stub
SUMMARIZER=claude_code
# Optional: haiku, sonnet or opus. Empty = your Claude Code default. Smaller models use less of
# your plan's usage limits.
CLAUDE_CODE_MODEL=
# Items per Claude Code call, and the most items summarized per refresh
SUMMARY_BATCH_SIZE=8
SUMMARIES_PER_RUN=80

# OpenAI (same variable names as CHIA), only used when SUMMARIZER=openai or auto
OPENAI_API_KEY=
SUMMARY_MODEL=gpt-5.4-mini

# Optional: route through Azure OpenAI instead (like CHIA's production setup)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2025-04-01-preview
AZURE_SUMMARY_DEPLOYMENT=

# Fetching
# 0 = only fetch when you click "Fetch new"
FETCH_INTERVAL_MINUTES=360
ITEMS_PER_QUERY=5
ALLOWED_ORIGINS=http://localhost:4200
